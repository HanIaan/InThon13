# ---- 실행 모드 ----
# mock: 결정적 데모 데이터 (data_status="mock"), live: Supabase/PostGIS 사전계산 지표 사용
DATA_MODE=mock
# live에서 데이터를 읽는 방식: snapshot = 서버를 켤 때 전부 메모리에 올림(오래 켜 두는 서버),
# query = 요청마다 필요한 칸만 읽음(Vercel 같은 서버리스). Vercel에서는 query를 쓴다.
LIVE_READ=snapshot
# CDN이 지도·위치·추천 응답을 저장할 시간(초). 0이면 끔. Vercel에서는 3600 권장.
CACHE_SECONDS=0

# 수집 산출물·사전계산 지표 위치 (backend/ 기준 상대경로)
PROCESSED_DATA_DIR=../data/processed

# ---- CORS ----
# 기본 개발 Origin(localhost:3000, localhost:5173)은 항상 허용됨
# 팀원 추가 개발 주소 (쉼표 구분)
CORS_DEV_ORIGINS=
# 배포 프론트엔드 도메인 (쉼표 구분, 예: https://sensory-map.vercel.app)
CORS_PROD_ORIGINS=

# ---- Supabase (서버 전용 — 절대 프론트엔드에 노출 금지) ----
# Postgres 직접 연결 문자열 (Supabase > Project Settings > Database)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 공공데이터 키 (서버/수집기 전용) ----
# 서울 열린데이터광장 인증키 (S-DoT, 생활인구)
SEOUL_OPEN_API_KEY=
# NASA Earthdata 토큰 (Black Marble VNP46)
NASA_EARTHDATA_TOKEN=

# ---- 프론트엔드 (.env.local) ----
# 비워 두면 저장된 격자 데이터로 동작한다. Vercel에서 화면과 API를 같이 배포하면 "/"로 둔다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 카카오 JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=
