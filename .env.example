# ---- 실행 모드 ----
# mock: 결정적 데모 데이터 (data_status="mock"), live: Supabase/PostGIS 사전계산 지표 사용
DATA_MODE=mock

# ---- CORS ----
# 기본 개발 Origin(localhost:3000, localhost:5173)은 항상 허용됨
# 팀원 추가 개발 주소 (쉼표 구분)
CORS_DEV_ORIGINS=
# 배포 프론트엔드 도메인 (쉼표 구분, 예: https://sensory-map.vercel.app)
CORS_PROD_ORIGINS=

# ---- Supabase (서버 전용 — 절대 프론트엔드에 노출 금지) ----
# Postgres 직접 연결 문자열 (Supabase > Project Settings > Database)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 공공데이터 키 (서버/수집기 전용) ----
# 서울 열린데이터광장 인증키 (S-DoT, 생활인구)
SEOUL_OPEN_API_KEY=
# NASA Earthdata 토큰 (Black Marble VNP46)
NASA_EARTHDATA_TOKEN=
